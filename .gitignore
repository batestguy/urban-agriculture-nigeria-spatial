# Data — keep structure but ignore large raw dumps (uncomment if needed)
# data/raw/*.csv
# data/raw/*.geojson
# data/external/*.tif
# Keep placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Secrets
.env
secrets.toml
*-secret.json

# Agent / tooling working artefacts (not part of the research record)
.codewhale/
.playwright-mcp/

# Large source documents kept out of git history
# (the thesis is the source of the survey statistics; it lives on Drive D and is
#  referenced from data/raw/README-survey-data.md rather than versioned here)
MR. YOHAN FINAL BINDING.docx

# Quarto scratch
manuscript/.quarto/
docs/.quarto/

# Render intermediates (methodology.qmd is the source; these are derived)
#  .typ is produced by --to typst, .tex by --to latex (the earlier attempt)
docs/methodology.typ
docs/methodology.tex

# Scratch files (commit messages, scratch scripts, logs).
# A commit-message file was once captured by `git add -A`, which then also made the
# next commit's message into that filename. Cheap to prevent.
commitmsg.txt
cm.txt
_*.py
_*.R
buildlog.txt
